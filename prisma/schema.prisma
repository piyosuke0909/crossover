generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EmailOtpPurpose {
  LOGIN
  VERIFY_EMAIL
}

model Company {
  id                  String             @id @default(cuid())
  name                String
  phone               String?
  showPhone           Boolean            @default(false)
  showAddress         Boolean            @default(false)
  postalCode          String?
  address             String?
  websiteUrl          String?
  businessDescription String
  profile             String?
  isHidden            Boolean            @default(false)
  industries          CompanyIndustry[]
  people              Person[]
  eventCompanies      EventCompany[]
  accessKeys          CompanyAccessKey[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([name])
}

model Person {
  id                    String                  @id @default(cuid())
  companyId             String
  company               Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                  String
  photoUrl              String
  email                 String?
  emailVerifiedAt       DateTime?
  emailOtpEnabled       Boolean                 @default(false)
  department            String?
  position              String?
  phone                 String?
  showPhone             Boolean                 @default(false)
  responsibility        String?
  profile               String?
  isHidden              Boolean                 @default(false)
  eventPeople           EventPerson[]
  sessions              ParticipantSession[]
  encountersOwned       Encounter[]             @relation("EncounterOwner")
  encountersMet         Encounter[]             @relation("EncounterMet")
  loginCredentials      PersonLoginCredential[]
  emailOtpChallenges    EmailOtpChallenge[]
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([companyId])
  @@index([name])
  @@index([email])
}

model Industry {
  id        String            @id @default(cuid())
  name      String            @unique
  isActive  Boolean           @default(true)
  companies CompanyIndustry[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model CompanyIndustry {
  id         String   @id @default(cuid())
  companyId  String
  industryId String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  industry   Industry @relation(fields: [industryId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())

  @@unique([companyId, industryId])
  @@index([industryId])
}

model Event {
  id             String               @id @default(cuid())
  name           String
  eventDate      DateTime
  venue          String?
  description    String?
  slug           String               @unique
  isActive       Boolean              @default(true)
  deletedAt      DateTime?
  eventCompanies EventCompany[]
  eventPeople    EventPerson[]
  sessions       ParticipantSession[]
  encounters     Encounter[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([eventDate])
  @@index([deletedAt])
}

model EventCompany {
  id        String   @id @default(cuid())
  eventId   String
  companyId String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())

  @@unique([eventId, companyId])
  @@index([companyId])
}

model EventPerson {
  id       String   @id @default(cuid())
  eventId  String
  personId String
  qrToken  String   @unique @default(cuid())
  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person   Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([eventId, personId])
  @@index([personId])
}

model ParticipantSession {
  id        String   @id @default(cuid())
  eventId   String
  personId  String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([eventId, personId])
  @@index([expiresAt])
}

model PersonLoginCredential {
  id         String    @id @default(cuid())
  personId   String
  person     Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  codeHash   String    @unique
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  lastUsedAt DateTime?

  @@index([personId])
}

model EmailOtpChallenge {
  id         String          @id @default(cuid())
  personId   String
  person     Person          @relation(fields: [personId], references: [id], onDelete: Cascade)
  eventId    String?
  purpose    EmailOtpPurpose
  email      String
  codeHash   String
  attempts   Int             @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime        @default(now())

  @@index([personId, purpose, createdAt])
  @@index([eventId, email])
  @@index([expiresAt])
}

model Encounter {
  id            String   @id @default(cuid())
  eventId       String
  ownerPersonId String
  metPersonId   String
  createdAt     DateTime @default(now())
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ownerPerson   Person   @relation("EncounterOwner", fields: [ownerPersonId], references: [id], onDelete: Cascade)
  metPerson     Person   @relation("EncounterMet", fields: [metPersonId], references: [id], onDelete: Cascade)

  @@unique([eventId, ownerPersonId, metPersonId])
  @@index([ownerPersonId])
  @@index([metPersonId])
}

model CompanyAccessKey {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  keyHash   String
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([companyId])
  @@index([keyHash])
}
